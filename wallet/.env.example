# Скопируй в .env и заполни. Значения берутся из Apple Developer.
PASS_TYPE_ID=pass.com.exit13.club        # твой Pass Type ID
TEAM_ID=XXXXXXXXXX                        # Team ID из Apple Developer
BASE_URL=https://exit13-wallet.onrender.com   # публичный URL этого бэкенда (https!)
ADMIN_TOKEN=придумай-длинный-секрет       # для /api/update, /api/push, /api/broadcast
PORT=4000

# Сертификаты (PEM). Как получить — см. SETUP.md
SIGNER_CERT=certs/signerCert.pem
SIGNER_KEY=certs/signerKey.pem
SIGNER_KEY_PASSPHRASE=пароль-от-ключа
WWDR=certs/wwdr.pem
